---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Drive — shared team document hub." />
    <title>Drive — Team Hub</title>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <div class="brand">
          <div class="brand-mark">D</div>
          <div>
            <div class="brand-name">Drive</div>
            <div class="brand-subtitle">Team document hub</div>
          </div>
        </div>
        <div class="status"><span></span> Supabase connected</div>
      </header>

      <section class="hero">
        <p class="eyebrow">TEAM DRIVE</p>
        <h1>Everything your team needs,<br /><em>in one place.</em></h1>
        <p class="intro">Open a collection to access its documents, data and project files.</p>
      </section>

      <section class="cards" id="collections" aria-label="Collections">
        <div class="loading-card">Loading collections…</div>
      </section>

      <footer>
        <span>Drive</span>
        <span>Shared with your team</span>
      </footer>
    </main>

    <script>
      import { supabase } from '../lib/supabase';

      const root = document.querySelector('#collections');
      const icons = ['⌁', '▤', '◌', '◇', '□'];

      function render(collections) {
        if (!collections.length) {
          root.innerHTML = '<div class="loading-card">No collections yet.</div>';
          return;
        }

        root.innerHTML = collections.map((collection, index) => `
          <a class="card" href="#collection-${collection.id}">
            <div class="card-top">
              <div class="card-icon">${icons[index % icons.length]}</div>
              <div class="arrow">↗</div>
            </div>
            <div class="card-content">
              <div class="card-type">${collection.type || 'Collection'}</div>
              <h2>${escapeHtml(collection.name)}</h2>
              <p>Open collection</p>
            </div>
          </a>
        `).join('');
      }

      function escapeHtml(value) {
        return String(value).replace(/[&<>'"]/g, (char) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
        }[char]));
      }

      async function loadCollections() {
        if (!supabase) {
          root.innerHTML = '<div class="loading-card">Supabase is not configured.</div>';
          return;
        }

        const { data, error } = await supabase
          .from('collections')
          .select('id, name, type, created_at')
          .order('created_at', { ascending: true });

        if (error) {
          console.error(error);
          root.innerHTML = '<div class="loading-card">Could not load collections.</div>';
          return;
        }

        render(data || []);
      }

      loadCollections();
    </script>
  </body>
</html>
